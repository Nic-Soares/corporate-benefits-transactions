%% Target flow of a full run. Solid boxes exist today; dashed ones are planned
%% (roadmap EP-07 setup, EP-08 simulator, EP-09 ETL, EP-10 export).
flowchart TD
    Start(["main.py setup / simulate / export"]) --> Phase1{"1. Setup"}

    Phase1 --> Schema["schema_creator.py<br>oltp_schema.sql → PostgreSQL (14 tables)<br>01_dimensions + 02_facts → DuckDB"]
    Schema --> RefLoad["Load reference tables from config/<br>products, transaction_modalities, acquirers,<br>mcc_modalities, cnae_products"]

    RefLoad --> Phase2{"2. Entities"}
    Phase2 --> Seed["fake.seed(n, today)"]
    Seed --> GenCompanies["Companies<br>holdings, then branches"]
    GenCompanies --> GenCardholders["Cardholders<br>admission ≥ registration"]
    GenCardholders --> GenCards["Cards<br>modality OWN or a brand"]
    GenCards --> GenCardProducts["Card products<br>VA, VR, VC, VF, VM, PR"]
    Seed --> GenEstab["Establishments<br>CNAE, MCC, category"]
    GenEstab --> GenTerminals["Terminals<br>model and type per acquirer"]
    GenCardProducts --> EntitiesReady["Entities in OLTP"]
    GenTerminals --> EntitiesReady

    EntitiesReady --> Phase3{"3. Simulation"}
    Phase3 --> TransGen["generate_single_transaction<br>card product + terminal + amount + capture type"]
    TransGen --> ValStatus["Status<br>card, cardholder, establishment, terminal,<br>card product, product, modality, acquirer"]
    ValStatus --> ValTemporal["Temporal<br>expiration, admission,<br>accreditation, installation"]
    ValTemporal --> ValBusiness["Business rules<br>OWN: CNAE × product (longest prefix)<br>brands: MCC × brand"]
    ValBusiness --> ValBalance["Balance and limits<br>balance, daily, monthly"]
    ValBalance --> ValInfra["Infrastructure<br>capture technology × terminal type"]
    ValInfra --> Decision{"All passed?"}
    Decision -- Yes --> Approved["00 - approved"]
    Decision -- No --> Declined["First failing code<br>13–62, 92–99"]
    Approved --> InsertTrans["INSERT transactions + authorizations"]
    Declined --> InsertTrans
    InsertTrans --> IsApproved{"Approved?"}
    IsApproved -- Yes --> DeductBalance["UPDATE card_products balance<br>INSERT balance_history"]
    IsApproved -- No --> CheckVolume
    DeductBalance --> CheckVolume{"Target volume reached?"}
    CheckVolume -- No --> TransGen
    CheckVolume -- Yes --> Phase4{"4. Analytics"}

    Phase4 --> ETL["ETL PostgreSQL → DuckDB<br>8 dimensions + fact_transactions"]
    ETL --> Export["Export Parquet"]
    Export --> End(["Kaggle dataset"])

    classDef planned stroke-dasharray: 5 5
    class Start,RefLoad,EntitiesReady,TransGen,Decision,Approved,Declined,InsertTrans,IsApproved,DeductBalance,CheckVolume,ETL,Export,End planned
    style Phase1 fill:#e3f2fd
    style Phase2 fill:#f3e5f5
    style Phase3 fill:#fce4ec
    style Phase4 fill:#e0f2f1
    style Approved fill:#c8e6c9
    style Declined fill:#ffcdd2
