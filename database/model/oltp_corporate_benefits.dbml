// OLTP Model - Corporate Benefits Operational System
// Focus: Fast transactions, CRUD operations, normalization
// PK naming: 'id' for all primary keys
// FK naming: '*_id' for all foreign keys

// SUPPORT TABLES
Table wallets {
  id varchar [primary key]
  name varchar [not null]
  category varchar [not null]
  active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table transaction_modalities {
  id varchar [primary key]
  name varchar [not null]
  type varchar [not null]
  active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table acquirers {
  id varchar [primary key]
  name varchar [not null]
  active boolean [default: true]
  created_at timestamp [default: `now()`]
}

Table card_programs {
  id varchar [primary key]
  name varchar [not null]
  network_type varchar [not null, note: 'proprietary_network (3-party) or brand (4-party)']
  active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table card_program_wallets {
  program_id varchar [not null]
  wallet_id varchar [not null]

  Indexes {
    (program_id, wallet_id) [pk]
  }
}

// MCC x MODALITIES MAPPING TABLE (for brands)
Table mcc_modalities {
  mcc_code varchar [not null]
  modality_id varchar [not null]
  mcc_description varchar [not null]
  observation varchar
  active boolean [default: true]
  created_at timestamp [default: `now()`]

  Primary Key (mcc_code, modality_id)
}

// CNAE x WALLETS MAPPING TABLE (for proprietary network)
Table cnae_wallets {
  cnae_code varchar [not null]
  wallet_id varchar [not null]
  cnae_description varchar
  observation varchar
  active boolean [default: true]
  created_at timestamp [default: `now()`]

  Primary Key (cnae_code, wallet_id)
}

Table mcc_wallets {
  mcc_code varchar [not null]
  wallet_id varchar [not null]
  Note: 'Brand (4-party) cards: wallets the issuer can charge at each MCC; GIFT takes any MCC and has no rows'

  Indexes {
    (mcc_code, wallet_id) [pk]
  }
}

// MAIN TABLES
Table companies {
  id varchar [primary key]
  parent_id varchar [note: 'NULL = holding; filled = filial/branch']
  cnpj varchar [unique, not null]
  name varchar [not null]
  trade_name varchar
  segment varchar [not null]
  city varchar [not null]
  state varchar [not null]
  status varchar [not null, default: 'active']
  registration_date date [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table cardholders {
  id varchar [primary key]
  company_id varchar [not null]
  cpf_hash varchar [unique, not null]
  name varchar [not null]
  city varchar [not null]
  state varchar [not null]
  admission_date date [not null]
  position varchar
  department varchar
  status varchar [not null, default: 'active']
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table cards {
  id varchar [primary key]
  cardholder_id varchar [not null]
  program_id varchar [not null]
  card_number_hash varchar [unique, not null]
  modality_id varchar [not null, note: 'OWN for proprietary-network programs; VISA, MASTERCARD or ELO for brand programs']
  expiration_date date [not null]
  card_type varchar [not null]
  status varchar [not null, default: 'active']
  issue_date date [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table card_wallets {
  id varchar [primary key]
  card_id varchar [not null]
  wallet_id varchar [not null]
  current_balance decimal(15,2) [not null, default: 0]
  daily_limit decimal(15,2) [default: 0]
  monthly_limit decimal(15,2) [default: 0]
  activation_date date [not null]
  status varchar [not null, default: 'active']
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table establishments {
  id varchar [primary key]
  cnpj varchar [unique, not null]
  name varchar [not null]
  trade_name varchar
  main_cnae varchar [not null]
  mcc_code varchar [not null]
  category varchar [not null]
  city varchar [not null]
  state varchar [not null]
  status varchar [not null, default: 'active']
  accreditation_date date [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table terminals {
  id varchar [primary key]
  establishment_id varchar [not null]
  acquirer_id varchar [not null]
  model varchar
  type varchar [not null]
  status varchar [not null, default: 'active']
  installation_date date [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

// TRANSACTIONS (basic attempt data)
Table transactions {
  id varchar [primary key]
  card_id varchar [not null]
  wallet_id varchar [note: 'Chosen by the cardholder (3-party) or routed by MCC (4-party); NULL when none could be routed']
  establishment_id varchar [not null]
  terminal_id varchar [not null]
  amount decimal(15,2) [not null]
  date timestamp [not null]
  capture_type varchar [not null]
  pin_status varchar [not null, note: 'ok, wrong or not_required']
  response_code varchar [not null, note: 'ISO 8583']
  response_message varchar
  decline_reason varchar [note: 'Specific cause behind the ISO code; NULL when approved']
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

// AUTHORIZATIONS (authorizer response)
Table authorizations {
  id varchar [primary key]
  transaction_id varchar [not null]
  authorization_code varchar
  nsu varchar [not null]
  authorization_datetime timestamp [not null]
  status varchar [not null]
  created_at timestamp [default: `now()`]
}

// BALANCE HISTORY (audit)
Table balance_history {
  id varchar [primary key]
  card_wallet_id varchar [not null]
  transaction_id varchar
  operation_type varchar [not null]
  operation_amount decimal(15,2) [not null]
  previous_balance decimal(15,2) [not null]
  posterior_balance decimal(15,2) [not null]
  operation_date timestamp [not null]
  created_at timestamp [default: `now()`]
}

// RELATIONSHIPS
Ref: companies.parent_id > companies.id
Ref: cardholders.company_id > companies.id
Ref: cards.cardholder_id > cardholders.id
Ref: cards.program_id > card_programs.id
Ref: cards.modality_id > transaction_modalities.id
Ref: card_program_wallets.program_id > card_programs.id
Ref: card_program_wallets.wallet_id > wallets.id
Ref: card_wallets.card_id > cards.id
Ref: card_wallets.wallet_id > wallets.id
Ref: terminals.establishment_id > establishments.id
Ref: terminals.acquirer_id > acquirers.id
Ref: mcc_modalities.modality_id > transaction_modalities.id
Ref: cnae_wallets.wallet_id > wallets.id
Ref: mcc_wallets.wallet_id > wallets.id
Ref: transactions.card_id > cards.id
Ref: transactions.wallet_id > wallets.id
Ref: transactions.establishment_id > establishments.id
Ref: transactions.terminal_id > terminals.id
Ref: authorizations.transaction_id > transactions.id
Ref: balance_history.card_wallet_id > card_wallets.id
Ref: balance_history.transaction_id > transactions.id
