// OLAP Model - Corporate Benefits Analytics (Snowflake/DuckDB)
// Denormalized for analytics performance while maintaining field name consistency with OLTP
// Docs: https://dbml.dbdiagram.io/docs
// Naming Convention:
// - Primary Keys: 'id' for all tables
// - Foreign Keys: '*_id' (descriptive suffix)
// - Timestamps: NONE (read-only, append-only system)

// ============================================================================
// DIMENSION TABLES (Denormalized from OLTP)
// ============================================================================

Table dim_wallets {
  id varchar [primary key]
  name varchar [not null]
  category varchar [not null]
  active boolean [default: true]
}

Table dim_card_programs {
  id varchar [primary key]
  name varchar [not null]
  network_type varchar [not null]
  active boolean [default: true]
}

Table dim_transaction_modalities {
  id varchar [primary key]
  name varchar [not null]
  type varchar [not null]
  active boolean [default: true]
}

Table dim_acquirers {
  id varchar [primary key]
  name varchar [not null]
  active boolean [default: true]
}

Table dim_cards {
  id varchar [primary key]
  cardholder_id varchar [not null]
  program_id varchar [not null]
  modality_id varchar [not null]
  card_type varchar [not null]
  expiration_date date [not null]
  issue_date date [not null]
  status varchar [not null]
}

Table dim_cardholders {
  id varchar [primary key]
  company_id varchar [not null]
  city varchar [not null]
  state varchar [not null]
  position varchar
  department varchar
  admission_date date [not null]
  status varchar [not null]
}

Table dim_companies {
  id varchar [primary key]
  parent_id varchar [note: 'NULL = holding; filled = filial/branch']
  name varchar [not null]
  trade_name varchar
  segment varchar [not null]
  city varchar [not null]
  state varchar [not null]
  status varchar [not null]
  registration_date date [not null]
}

Table dim_establishments {
  id varchar [primary key]
  name varchar [not null]
  trade_name varchar
  main_cnae varchar [not null]
  mcc_code varchar [not null]
  category varchar [not null]
  city varchar [not null]
  state varchar [not null]
  status varchar [not null]
  accreditation_date date [not null]
}

Table dim_terminals {
  id varchar [primary key]
  establishment_id varchar [not null]
  acquirer_id varchar [not null]
  model varchar
  type varchar [not null]
  status varchar [not null]
  installation_date date [not null]
}

Table dim_card_wallets {
  id varchar [primary key]
  card_id varchar [not null]
  wallet_id varchar [not null]
  monthly_credit decimal(15,2) [not null]
  daily_limit decimal(15,2)
  monthly_limit decimal(15,2)
  daily_count_limit integer
  final_balance decimal(15,2) [not null, note: 'Balance at the end of the simulation']
  activation_date date [not null]
  status varchar [not null]
}

// ============================================================================
// REFERENCE TABLES (the rules behind the answers)
// ============================================================================

Table ref_response_codes {
  id varchar [primary key, note: 'ISO 8583']
  description varchar [not null]
}

Table ref_cnae_wallets {
  cnae_code varchar [not null]
  wallet_id varchar [not null]
  cnae_description varchar
  active boolean [not null]

  Indexes {
    (cnae_code, wallet_id) [pk]
  }
}

Table ref_program_wallets {
  program_id varchar [not null]
  wallet_id varchar [not null]

  Indexes {
    (program_id, wallet_id) [pk]
  }
}

Table ref_mcc_wallets {
  mcc_code varchar [not null]
  wallet_id varchar [not null]

  Indexes {
    (mcc_code, wallet_id) [pk]
  }
}

Table ref_mcc_modalities {
  mcc_code varchar [not null]
  modality_id varchar [not null]
  mcc_description varchar [not null]
  active boolean [not null]

  Indexes {
    (mcc_code, modality_id) [pk]
  }
}

// ============================================================================
// FACT TABLES (Denormalized from OLTP transactions and balance_history)
// ============================================================================

Table fact_transactions {
  id varchar [primary key]
  related_transaction_id varchar [note: 'Self-reference for reversals']

  // Foreign Keys to dimensions
  card_id varchar [not null]
  cardholder_id varchar [not null]
  company_id varchar [not null]
  program_id varchar [not null]
  modality_id varchar [not null, note: 'Network: OWN or a brand']
  card_wallet_id varchar
  wallet_id varchar [note: 'From the card wallet charged']
  transaction_type varchar [not null, note: 'purchase, withdrawal or reversal']
  wallet_option varchar [note: 'Proprietary network: FOOD, MEAL or OTHERS']
  establishment_id varchar [not null]
  terminal_id varchar [not null]
  acquirer_id varchar [not null]

  // Financial Measures
  amount decimal(15,2) [not null]

  // Transaction Timing
  date timestamp [not null]

  // Transaction Details (from OLTP transactions)
  capture_type varchar [not null]
  pin_status varchar [not null]
  response_code varchar [not null]
  response_message varchar [note: 'From response_codes']
  decline_reason varchar
  nsu varchar [not null]
  authorization_code varchar
  is_fraud boolean [not null]
  fraud_scenario varchar
  disputed boolean [not null]
}

Table fact_balance_movements {
  id varchar [primary key]
  card_wallet_id varchar [not null]
  card_id varchar [not null]
  wallet_id varchar [not null]
  transaction_id varchar [note: 'NULL for the monthly credit']
  operation_type varchar [not null, note: 'credit, purchase, withdrawal or reversal']
  operation_amount decimal(15,2) [not null]
  previous_balance decimal(15,2) [not null]
  posterior_balance decimal(15,2) [not null]
  operation_date timestamp [not null]
}

// ============================================================================
// RELATIONSHIPS
// ============================================================================

Ref: dim_companies.parent_id > dim_companies.id [comment: 'Corporate hierarchy: holding/branch']

Ref: dim_cards.cardholder_id > dim_cardholders.id
Ref: dim_cards.program_id > dim_card_programs.id
Ref: dim_cards.modality_id > dim_transaction_modalities.id

Ref: dim_cardholders.company_id > dim_companies.id

Ref: dim_terminals.establishment_id > dim_establishments.id
Ref: dim_terminals.acquirer_id > dim_acquirers.id

Ref: fact_transactions.related_transaction_id > fact_transactions.id
Ref: fact_transactions.card_id > dim_cards.id
Ref: fact_transactions.cardholder_id > dim_cardholders.id
Ref: fact_transactions.program_id > dim_card_programs.id
Ref: fact_transactions.wallet_id > dim_wallets.id
Ref: fact_transactions.establishment_id > dim_establishments.id
Ref: fact_transactions.terminal_id > dim_terminals.id
Ref: fact_transactions.company_id > dim_companies.id
Ref: fact_transactions.modality_id > dim_transaction_modalities.id
Ref: fact_transactions.acquirer_id > dim_acquirers.id
Ref: fact_transactions.card_wallet_id > dim_card_wallets.id
Ref: fact_transactions.response_code > ref_response_codes.id
Ref: ref_program_wallets.program_id > dim_card_programs.id
Ref: ref_program_wallets.wallet_id > dim_wallets.id
Ref: ref_cnae_wallets.wallet_id > dim_wallets.id
Ref: ref_mcc_wallets.wallet_id > dim_wallets.id
Ref: ref_mcc_modalities.modality_id > dim_transaction_modalities.id

Ref: dim_card_wallets.card_id > dim_cards.id
Ref: dim_card_wallets.wallet_id > dim_wallets.id

Ref: fact_balance_movements.card_wallet_id > dim_card_wallets.id
Ref: fact_balance_movements.card_id > dim_cards.id
Ref: fact_balance_movements.wallet_id > dim_wallets.id
Ref: fact_balance_movements.transaction_id > fact_transactions.id
